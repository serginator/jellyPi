# Run 'id' in the Pi terminal to get your PUID/PGID (usually both 1000)
PUID=1000
PGID=1000

# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Madrid

STORAGE=/mnt/storage

# API keys — find them in each service under Settings → General
# Required by Decluttarr and Unpackerr
SONARR_API_KEY=
RADARR_API_KEY=

# qBittorrent password — required by Decluttarr
QBITTORRENT_PASSWORD=

# Optional — only needed for Homepage's Jellyfin/Seerr widgets (live stats).
# Without these, homepage-setup.sh still adds them as plain links.
# Jellyfin: Dashboard → API Keys → +
# Seerr: Settings → General → API Key
JELLYFIN_API_KEY=
SEERR_API_KEY=

# Optional — Homepage's Bazarr widget (missing episodes/movies count).
# Bazarr: Settings → General → API Key
BAZARR_API_KEY=

# Optional — Homepage's Tailscale widget (VPN IP, update available).
# Both are required together, or the widget is skipped:
# Access Token: https://login.tailscale.com/admin/settings/keys
# Device ID: https://login.tailscale.com/admin/machines → select this Pi →
# Machine Details → ID (ends with CNTRL)
TAILSCALE_API_KEY=
TAILSCALE_DEVICE_ID=

# Optional — Homepage visual theme. Set to "cyberpunk" for a neon/dark look
# (scanline overlay + glowing headings/links). Anything else (or unset) keeps
# the default look.
HOMEPAGE_THEME=default

# Tailscale auth key — generate at tailscale.com/admin/settings/keys (mark as Reusable)
TS_AUTHKEY=

# Private Internet Access credentials (for Gluetun VPN)
PIA_USER=
PIA_PASSWORD=
# Optional: set a specific region, default is Spain
# Full list: https://github.com/qdm12/gluetun-wiki/blob/main/setup/providers/private-internet-access.md
PIA_SERVER_REGION="ES Madrid"

# Telegram notifications — create a bot with @BotFather to get the token,
# then message the bot and check https://api.telegram.org/bot<TOKEN>/getUpdates
# to find your chat_id. Used by telegram-setup.sh to configure Sonarr/Radarr,
# and by Diun to notify of new container image versions.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Homepage's Portainer widget (running/stopped container counts).
# Portainer has no auto-generated key like the Servarr apps: open
# http://jellypi.local:9000 once and create the admin account (recent
# versions ask for a setup token — find it with `docker logs portainer`
# right after its first start), then Settings → API access tokens → Add.
PORTAINER_API_KEY=
